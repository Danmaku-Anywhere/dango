{
  "name": "@mr-quin/dango",
  "version": "0.10.1",
  "description": "Declarative danmaku source manifest engine",
  "author": "Mr-Quin",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danmaku-Anywhere/dango.git",
    "directory": "packages/dango"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@nodable/entities": "^3.1.0",
    "fast-xml-parser": "^5.12.1",
    "js-md5": "^0.11.0",
    "jsonata": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {}
}
